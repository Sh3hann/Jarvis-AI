config/voice_id.tmp
config/voice_id_model/
config/memory_audit.key
config/memory_audit.anchor
config/memory_encryption.key
config/memory_settings.json

# Generic secrets, private keys, certificates
.env
.env.*
!.env.example
**/*token*.json
!**/*token*.example.json
**/*secret*.json
!**/*secret*.example.json
**/client_secret*.json
!**/client_secret*.example.json
**/*credential*.json
!**/*credential*.example.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer

