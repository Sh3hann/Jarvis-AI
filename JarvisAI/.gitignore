# API Keys, secrets, tokens, credentials
config/api_keys.json
config/api_keys.json.tmp
config/api_keys.json.corrupt-*
config/google_credentials.json
config/google_token.json
config/phone_handoff.json
config/certs/
config/whatsapp_web/
